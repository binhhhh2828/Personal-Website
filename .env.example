# ─── Site URLs ────────────────────────────────────────────────────────────────
# Public origin of the personal website (no trailing slash).
NEXT_PUBLIC_MAIN_URL=http://localhost:3000

# Public origin of IELTS Writing Lab.
#   • Leave EMPTY to serve IELTS under the main domain at /ielts  ("path mode").
#     This is the default for local development and Vercel preview URLs.
#   • Set it to enable "subdomain mode": IELTS is served at the root of this host,
#     and /ielts/* on the main domain permanently redirects here.
# Examples:
#   NEXT_PUBLIC_IELTS_URL=http://ielts.localhost:3000     (local subdomain test)
#   NEXT_PUBLIC_IELTS_URL=https://ielts.yourname.id.vn    (production)
NEXT_PUBLIC_IELTS_URL=

# Show MDX files marked `draft: true` in a production build (dev always shows them).
SHOW_DRAFTS=false
